# Login environment for the VPS shells (web terminal + SSH).
[ -f /etc/bashrc ] && . /etc/bashrc
export VPS_HOME="${VPS_HOME:-$HOME/data}"
export PATH="$VPS_HOME/bin:$VPS_HOME/.vps/nixbin:$(dirname "${BASH_SOURCE[0]}")/bin:$HOME/.nix-profile/bin:$PATH"
PS1='\[\e[1;32m\]\u@vps\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
alias ll='ls -alF' la='ls -A' l='ls -CF' cls=clear
[ -f "$VPS_HOME/.bashrc" ] && . "$VPS_HOME/.bashrc"   # your own saved customizations
if [ -z "$VPS_MOTD_SHOWN" ] && [[ $- == *i* ]]; then
  export VPS_MOTD_SHOWN=1
  # neofetch is slow (~1-2s), so only show it on the first login of the day
  stamp="$VPS_HOME/.vps/motd-day"
  if [ "$(cat "$stamp" 2>/dev/null)" != "$(date +%F)" ]; then
    date +%F > "$stamp"; command -v neofetch >/dev/null && neofetch
  fi
  echo "Files in ~/data are saved to Filebase. Use 'apt install <pkg>' to add software."
fi
